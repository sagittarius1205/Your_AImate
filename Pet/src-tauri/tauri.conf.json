{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VRPet Spike",
  "version": "0.1.0",
  "identifier": "com.vrphysproto.pet.spike",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "VRPet Spike",
        "width": 460,
        "height": 620,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": []
  }
}
